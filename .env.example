# ============================================================
# 🔑 SEGURANÇA, HASH DETERMINÍSTICO E AUDITORIA (LGPD / DLP)
# ============================================================
# O SALT garante que os mesmos nomes/CPFs virem os mesmos dados falsos
# em todas as tabelas e arquivos, sem precisar de tabela de/para desprotegida.
ANONYMIZER_SECRET_SALT=SuaChaveSaltSeguraHomologacao2026!

# ============================================================
# 🧠 IA LOCAL ON-PREMISE (OLLAMA)
# ============================================================
OLLAMA_URL=http://ollama:11434/api/generate
# Modelo específico ultraleve (~1.3 GB) ideal para classificação e validação rápida em CPU
OLLAMA_MODEL=llama3.2:1b

# ============================================================
# 🗄️ PARÂMETROS DE BANCO DE DADOS
# ============================================================
# Tamanho padrão do lote (Recomendado: 9000 para não estourar o limite de 10k de bancos externos)
CHUNK_SIZE_DB=9000

# BANCO ORIGEM (Banco restrito controlado por terceiros - Somente Leitura / SELECT)
# Exemplos:
# PostgreSQL: postgresql+psycopg2://user_leitura:senha@192.168.1.100:5432/banco_producao
# SQL Server: mssql+pyodbc://user_leitura:senha@192.168.1.100:1433/banco_producao?driver=ODBC+Driver+17+for+SQL+Server
# MySQL:      mysql+pymysql://user_leitura:senha@192.168.1.100:3306/banco_producao
DB_SOURCE=

# BANCO DESTINO (Seu banco local / homologação com permissão livre de escrita)
# Para apontar para o banco na própria máquina host da VM via Docker, utilize 'host.docker.internal'
# Exemplo PostgreSQL Local:
# postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/banco_anonimizado
DB_TARGET=

# ============================================================
# 🌐 CONFIGURAÇÃO DE PROXY CORPORATIVO (Se necessário)
# ============================================================
# HTTP_PROXY=http://usuario:senha@proxy00.sesp.parana:8080
# HTTPS_PROXY=http://usuario:senha@proxy00.sesp.parana:8080
# NO_PROXY=127.0.0.1,localhost,ollama,app,host.docker.internal
